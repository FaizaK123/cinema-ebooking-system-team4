# Copy this file to backend/.env and fill in the values.
# backend/.env is git-ignored, so passwords never reach GitHub.

# ---- Email (confirmation, password reset, profile-change notices) ----
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (16 letters, no spaces).
# Leave SMTP_HOST empty to save emails to backend/instance/outbox/ instead of sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourteamaccount@gmail.com
SMTP_PASSWORD=your16letterapppassword
MAIL_FROM=yourteamaccount@gmail.com

# ---- Default admin account (created the first time the database is set up) ----
ADMIN_EMAIL=admin@ces.local
ADMIN_PASSWORD=Admin1234!

# ---- Optional: set these to share keys between machines. ----
# If left out, random keys are generated in backend/instance/ on first run.
# SECRET_KEY=
# CARD_ENCRYPTION_KEY=
